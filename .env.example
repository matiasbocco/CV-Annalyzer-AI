OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DATABASE_URL=mysql+aiomysql://cvuser:cvpass@localhost:3306/cv_analyzer
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
MAX_CVS_PER_ANALYSIS=30

# Deployment settings — defaults below are correct for local dev, do not change them locally.
# FRONTEND_URL: origin(s) allowed by CORS + used for links (password reset). Comma-separate multiple.
FRONTEND_URL=http://localhost:5173
# COOKIE_SECURE: set to true in production behind HTTPS. Must stay false for local HTTP dev.
COOKIE_SECURE=false
# CHROMA_DB_PATH: point at a mounted volume in production so the CV bank survives redeploys.
CHROMA_DB_PATH=./chroma_db
# INTERNAL_VECTOR_API_URL: dejar vacío en desarrollo local y en el
# servicio del backend en producción. Se setea SOLO en el servicio del
# worker de Celery en producción, apuntando a la URL de red privada de
# Railway del backend (ej: http://cv-annalyzer-ai.railway.internal:8000).
# Cuando está seteado, el worker reenvía toda operación de ChromaDB al
# backend en vez de tocar su propio disco — ver core/routers/internal_router.py.
INTERNAL_VECTOR_API_URL=
# INTERNAL_API_SECRET: secreto compartido que validan los endpoints
# internos. Debe ser idéntico en backend y worker en producción. El
# default de abajo alcanza para desarrollo local.
INTERNAL_API_SECRET=dev-internal-secret-not-for-production
